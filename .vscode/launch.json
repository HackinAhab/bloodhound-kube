{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
    {
        "name": "Launch file",
        "type": "go",
        "request": "launch",
        "mode": "debug",
        "program": "${file}"
    },
    {
        "name": "Launch CLI - report",
        "type": "go",
        "request": "launch",
        "mode": "auto",
        "program": "${workspaceFolder}/main.go",
        "args": [
            "report",
            "-i", "output/test-data.jsonl",
            "-o", "output/test-report",
            "--report", "all"
        ],
        "cwd": "${workspaceFolder}",
    },
    {
        "name": "Launch CLI - collect",
        "type": "go",
        "request": "launch",
        "mode": "auto",
        "program": "${workspaceFolder}/main.go",
        "args": [
            "collect",
            "-o", "output/test-data.jsonl"
        ],
        "cwd": "${workspaceFolder}",
    },
    {
        "name": "Launch CLI - parse",
        "type": "go",
        "request": "launch",
        "mode": "auto",
        "program": "${workspaceFolder}/main.go",
        "args": [
            "parse",
            "-i","output/test-data.jsonl",
            "-o", "output/test-parse.json"
        ],
        "cwd": "${workspaceFolder}",
    }
    ]
}